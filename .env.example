# Copie para .env e ajuste. Em cada máquina os valores podem ser diferentes.
# O Django não lê o .env sozinho: carregue com `source .env` (Linux/macOS)
# ou defina as variáveis no terminal (veja o README).

DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True

# IPs/nomes pelos quais a API será acessada (separados por vírgula)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.10

# Origem do painel, se ele for uma página web servida de outra máquina
CORS_ALLOWED_ORIGINS=http://192.168.0.20:8080
CSRF_TRUSTED_ORIGINS=http://192.168.0.20:8080
